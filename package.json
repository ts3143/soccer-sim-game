{
  "name": "soccer-sim-game",
  "private": true,
  "version": "0.3.0",
  "description": "Browser-based soccer management sim in the spirit of the ZenGM games.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx tools/check-bundle.ts",
    "preview": "vite preview",
    "browsercheck": "tsx tools/browser-checks/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check . && tsc -b",
    "format": "prettier --write .",
    "calendar": "tsx tools/calendar.ts",
    "calibrate": "tsx tools/calibrate/index.ts",
    "season": "tsx tools/season.ts",
    "generate": "tsx tools/generate/index.ts"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "idb": "8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
